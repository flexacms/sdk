{
    "name": "@flexacms/client",
    "version": "0.2.0",
    "description": "Typed, dependency-free client for the Flexa headless CMS content API.",
    "keywords": [
        "api-client",
        "cms",
        "flexa",
        "headless",
        "sdk"
    ],
    "homepage": "https://github.com/flexacms/sdk/tree/main/packages/client#readme",
    "bugs": {
        "url": "https://github.com/flexacms/sdk/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flexacms/sdk.git",
        "directory": "packages/client"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "engines": {
        "node": ">=20"
    }
}
