{
    "name": "@flexacms/next",
    "version": "0.2.0",
    "description": "Next.js integration for the Flexa headless CMS: cached server-side fetching with tag revalidation.",
    "keywords": [
        "cms",
        "flexa",
        "headless",
        "nextjs",
        "react-server-components"
    ],
    "homepage": "https://github.com/flexacms/sdk/tree/main/packages/next#readme",
    "bugs": {
        "url": "https://github.com/flexacms/sdk/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flexacms/sdk.git",
        "directory": "packages/next"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@flexacms/client": "^0.2.0"
    },
    "devDependencies": {
        "next": "^16.4.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "peerDependencies": {
        "next": ">=15.0.0"
    }
}
