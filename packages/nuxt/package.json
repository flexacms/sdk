{
    "name": "@flexacms/nuxt",
    "version": "0.3.0",
    "description": "Nuxt module for the Flexa headless CMS: auto-imported composables and a read-only server proxy that keeps your API key private.",
    "keywords": [
        "cms",
        "flexa",
        "headless",
        "nuxt",
        "nuxt-module",
        "vue"
    ],
    "homepage": "https://github.com/flexacms/sdk/tree/main/packages/nuxt#readme",
    "bugs": {
        "url": "https://github.com/flexacms/sdk/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flexacms/sdk.git",
        "directory": "packages/nuxt"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "./dist/module.js",
    "types": "./dist/module.d.ts",
    "exports": {
        ".": {
            "types": "./dist/module.d.ts",
            "default": "./dist/module.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@flexacms/client": "^0.3.0",
        "@nuxt/kit": "^3.12.0 || ^4.0.0",
        "defu": "^6.1.4"
    },
    "devDependencies": {
        "@nuxt/kit": "^4.6.1",
        "@nuxt/schema": "^4.6.1",
        "h3": "^1.15.11",
        "vue": "^3.5.0"
    }
}
