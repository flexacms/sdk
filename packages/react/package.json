{
    "name": "@flexacms/react",
    "version": "0.3.0",
    "description": "React provider and hooks for the Flexa headless CMS.",
    "keywords": [
        "cms",
        "flexa",
        "headless",
        "hooks",
        "react"
    ],
    "homepage": "https://github.com/flexacms/sdk/tree/main/packages/react#readme",
    "bugs": {
        "url": "https://github.com/flexacms/sdk/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flexacms/sdk.git",
        "directory": "packages/react"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@flexacms/client": "^0.3.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "jsdom": "^30.1.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0"
    }
}
