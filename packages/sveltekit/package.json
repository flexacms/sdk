{
    "name": "@flexacms/sveltekit",
    "version": "0.1.0",
    "description": "SvelteKit integration for the Flexa headless CMS: a server hook that puts a Flexa client on event.locals.",
    "keywords": [
        "cms",
        "flexa",
        "headless",
        "svelte",
        "sveltekit"
    ],
    "homepage": "https://github.com/flexacms/sdk/tree/main/packages/sveltekit#readme",
    "bugs": {
        "url": "https://github.com/flexacms/sdk/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/flexacms/sdk.git",
        "directory": "packages/sveltekit"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@flexacms/client": "^0.1.0"
    },
    "peerDependencies": {
        "@sveltejs/kit": ">=2.0.0"
    }
}
